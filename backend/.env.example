# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:5000/api/auth/google/callback

# JWT Secret Key
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# MySQL Configuration
# Format: user:password@tcp(host:port)/db?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/napscan?charset=utf8mb4&parseTime=True&loc=Local

# CORS (required for cookie-based auth)
# Comma-separated origins, e.g. http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# Auth Cookie (dev helpers)
AUTH_COOKIE_DEBUG=false

# For cross-site frontend/backend (different domains), set:
# AUTH_COOKIE_SAMESITE=None
# AUTH_COOKIE_SECURE=true

# Server Configuration
PORT=5000
